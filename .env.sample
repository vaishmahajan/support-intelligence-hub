# ══════════════════════════════════════════════════════════════
# Red Hat CEE BI Capstone #2 — Environment Configuration
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# The values below are fine for a laptop and NOT fine on a server: they are
# published in this repository, so they are public. Set APP_ENV=production
# and the apps will refuse to start until you have replaced every one of them.
# ══════════════════════════════════════════════════════════════

# ── Environment ──
# development = permissive defaults, localhost URLs
# production  = fail fast on a missing, weak or published secret
APP_ENV=development

# ── AI / LLM Endpoint Configuration (get from your Red Hat AI platform) ──
AI_ENDPOINT_URL=https://your-granite-endpoint.example.com/v1
AI_MODEL_ID=ibm-granite/granite-3.1-8b-instruct
AI_API_TOKEN=your-api-token-here

# ── PostgreSQL Database ──
POSTGRES_USER=capstone
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=capstone2
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://capstone:change_me_in_production@localhost:5433/capstone2

# ── RBAC Credentials ──
# Minimum 12 characters in production.
ADMIN_PASSWORD=admin2026
MANAGER_PASSWORD=manager2026
ASSOCIATE_PASSWORD=associate2026

# ── Seeded dashboard logins (read by setup_database2.py, not by the apps) ──
# These are hashed into registered_users at database-build time, so set them
# BEFORE running setup_database2.py — changing them afterwards does nothing
# until you reseed. APP_ENV=production cannot check these two: by the time any
# app starts they are bcrypt hashes, with no plaintext left to compare.
SEED_MANAGER_PASSWORD=manager123
SEED_ASSOCIATE_PASSWORD=associate123

# ── JWT Configuration ──
# Minimum 32 characters in production. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=capstone2-jwt-secret-change-in-prod
JWT_EXPIRE_MINUTES=60

# ── Anti-Scraping Secret (shared between API and frontends) ──
FRONTEND_TOKEN_SECRET=change-this-to-a-random-secret-for-frontend-signing

# ── Service Ports (local runs only; behind the proxy nothing is published) ──
API_PORT=8503
CUSTOMER_DASHBOARD_PORT=8501
ASSOCIATES_DASHBOARD_PORT=8502

# ══════════════════════════════════════════════════════════════
# HOSTING — required when APP_ENV=production
# ══════════════════════════════════════════════════════════════

# The URLs a *browser* uses. Cross-app links and the API's CORS allow-list are
# built from these, so localhost values would break every link for every user.
# Plain http:// is rejected unless you also set ALLOW_INSECURE_HTTP=true.
PUBLIC_CUSTOMER_URL=https://cust.example.com
PUBLIC_ASSOCIATES_URL=https://assoc.example.com
PUBLIC_API_URL=https://api.example.com

# Optional: override the CORS allow-list instead of deriving it from the above.
# CORS_ORIGINS=https://cust.example.com,https://assoc.example.com

# Set only if you terminate TLS elsewhere and the network is already secured.
# ALLOW_INSECURE_HTTP=false

# Ignore any .env file and take configuration purely from the environment.
# DOTENV_DISABLE=true

# ── Domains for the Caddy TLS proxy (docker-compose.prod.yml) ──
CUSTOMER_DOMAIN=cust.example.com
ASSOCIATES_DOMAIN=assoc.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# ── Login lockout (shared across replicas via the database) ──
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_SECONDS=300

# Lifetime of a cross-app handoff link. Short on purpose: the token rides in a
# URL, so it should be useless by the time it reaches a log file.
HANDOFF_TTL_SECONDS=60
